# PDA Phase 8 uses the existing MES platform Kafka broker.
PDA_MESSAGING_MODE=kafka
PDA_KAFKA_BROKERS=127.0.0.1:19092
PDA_KAFKA_GROUP_ID=pda-be08
PDA_KAFKA_TOPIC_PREFIX=pda
PDA_KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Inside a container attached to platform-net, use kafka:9092 instead.
# PDA_KAFKA_BROKERS=kafka:9092
